# Leave DATABASE_URL empty to use a local SQLite file (local development only).
# On Vercel it is required: paste your Neon / Supabase Postgres connection string.
DATABASE_URL=

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First HR login, created automatically when the database is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Non-working weekdays for leave counting (Mon=0 ... Sun=6). "6" = Sunday only, "5,6" = Sat+Sun.
WEEKEND_DAYS=6
